<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollFestivos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:background="@color/bg_app"> <!-- Fondo general caluroso -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- CABECERA: TÍTULO Y FILTRO DE AÑO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvDescripcion1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Festivos del año:"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spAnio"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:background="@android:drawable/btn_dropdown" />
        </LinearLayout>

        <!-- TARJETA CONTENEDORA PARA EL LISTADO (RECYCLERVIEW) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"> <!-- Mantenemos blanco puro para legibilidad del listado -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFestivos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp" />
        </androidx.cardview.widget.CardView>

        <!-- FILA DE BOTONES DE ACCIÓN (ELIMINAR Y NUEVO) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Botón Redondo Eliminar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEliminarBoton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="24dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#F00C0C"> <!-- Rojo de advertencia estándar para destrucción -->
                <ImageView
                    android:id="@+id/ivEliminar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp"
                    android:contentDescription="Eliminar"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#FFFFFF"
                    android:background="?android:attr/selectableItemBackground" />
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Botón Redondo Nuevo -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNuevoBoton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#6C27E8"> <!-- Color Primario (Ámbar Quemado) -->
                <ImageView
                    android:id="@+id/ivNuevo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp"
                    android:contentDescription="Nuevo"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#FFFFFF"
                    android:background="?android:attr/selectableItemBackground" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Divisor sutil adaptado a la calidez -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_fecha_disabled"
            android:layout_marginBottom="20dp" />

        <!-- SECTOR SELECCIÓN DE FECHA PREMIUM -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFechaContenedor"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_fecha_disabled"> <!-- Fondo inicial Arena -->
            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Pulsar aquí para elegir fecha 📅"
                android:textColor="@color/text_disabled"
                android:textSize="15sp"
                android:textStyle="bold"
                android:enabled="false"
                android:background="?android:attr/selectableItemBackground" />
        </androidx.cardview.widget.CardView>

        <!-- DESPLEGABLE TIPO DE FESTIVO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de jornada:"
            android:textColor="@color/text_disabled"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spFestivo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/btn_dropdown" />

        <!-- BOTÓN FINAL DE GUARDAR -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Añadir Registro"
            android:backgroundTint="@color/bg_btn_disabled"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
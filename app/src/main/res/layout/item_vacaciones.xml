<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItemVacaciones"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_fecha_active">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?android:attr/selectableItemBackground">

        <!-- Icono de Calendario / Maleta para VacacionesActivity -->
        <ImageView
            android:id="@+id/ivVacacionesIcono"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/calendar_svgrepo_com"
            android:importantForAccessibility="no" />

        <!-- Bloque de textos alineado verticalmente -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Título que muestra el rango o el total de días -->
            <TextView
                android:id="@+id/tvVacacionesDias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Periodo de Vacaciones (5 días)"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Subtítulo con las fechas de inicio y fin -->
            <TextView
                android:id="@+id/tvVacacionesFechas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Del 01/08/2026 al 05/08/2026"
                android:textColor="#000000"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Botón de Papelera Estilizado -->
        <ImageButton
            android:id="@+id/ivDeleteVacaciones"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_eliminar"
            android:tint="#D4A373"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar periodo de vacaciones" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
